{
    // rust-analyzer is configured for the bare-metal STM32C562RE target so that
    // inlay hints, diagnostics, and go-to-definition resolve against the same
    // cross-compilation target the firmware is actually built for.
    "rust-analyzer.cargo.target": "thumbv8m.main-none-eabihf",
    // Mirror the CI lint gate: on-save checking runs clippy, not a plain `cargo
    // check`, so editor squiggles match `cargo clippy -- -D warnings` in CI.
    "rust-analyzer.check.command": "clippy",
    "rust-analyzer.check.extraArgs": [
        "--",
        "-D",
        "warnings"
    ],
    // This is a `#![no_std]` binary: the `test`/`bench` targets cannot link
    // against `std`, so keep rust-analyzer (and its clippy pass) to the real
    // firmware target instead of trying to build all targets.
    "rust-analyzer.cargo.allTargets": false,
    "rust-analyzer.check.allTargets": false,
    // Format on save with the same rustfmt rules CI enforces (rustfmt.toml).
    "editor.formatOnSave": true,
    "[rust]": {
        "editor.defaultFormatter": "rust-lang.rust-analyzer"
    },
    "[toml]": {
        "editor.defaultFormatter": "tamasfe.even-better-toml"
    },
    // Keep the file watcher and search out of the (large) build output.
    "files.watcherExclude": {
        "**/target/**": true
    },
    "search.exclude": {
        "**/target": true
    },
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true
}
